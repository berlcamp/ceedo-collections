# PORT 56321, NOT THE 54321 DEFAULT. More than one Supabase stack runs on the development
# machine and another project owns 54321, so supabase/config.toml declares this project's
# own ports (see the README). Pointed at 54321 this app reaches the OTHER project's
# gateway, signs in against its GoTrue, finds no ceedo_collections membership and shows
# "No access to this system" -- a message that is true and points nowhere useful.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
